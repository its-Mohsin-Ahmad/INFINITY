# ---------------------------------------------------------------------------
# INFINITY platform environment
# Copy to `.env.local` and fill in. Nothing here is required for the demo
# dataset to run: the JSON repository adapter is the default data source.
# ---------------------------------------------------------------------------

# Public site origin (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Session signing secret (HMAC-SHA256 for the session cookie).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
INFINITY_SESSION_SECRET=replace-with-a-48-byte-random-hex-string

# Seed administrator credentials for the admin control centre
INFINITY_ADMIN_EMAIL=admin@infinity.gg
INFINITY_ADMIN_PASSWORD=Infinity#2026

# Optional: switch the repository adapter. `json` (default) | `memory`
INFINITY_DATA_ADAPTER=json

# Optional: Postgres/Supabase connection string for the SQL adapter
# DATABASE_URL=postgresql://user:password@host:5432/infinity

# Optional: CDN base for licensed/authorised cover artwork.
# When empty, INFINITY renders its own deterministic generated key art.
NEXT_PUBLIC_MEDIA_CDN=
